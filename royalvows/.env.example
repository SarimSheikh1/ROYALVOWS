MONGODB_URI=mongodb://localhost:27017/royalvows_demo?replicaSet=rs0
SESSION_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development

# Optional authorized SMTP delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# SITE_URL=https://your-configured-domain.example

# Optional production gallery storage (private provider URL)
CLOUDINARY_URL=
VENUE_TIMEZONE=Asia/Karachi

# Automatic WhatsApp notification when an admin confirms a booking.
# Fill these in the private .env file; never commit an access token.
WHATSAPP_CONFIRMATION_TO=923170046008
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
