{
  "name": "@royalvows/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/tests/*.test.ts",
    "seed": "tsx --env-file=../.env src/cli.ts seed",
    "create-admin": "tsx --env-file=../.env src/cli.ts admin",
    "worker": "tsx --env-file=../.env src/worker.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^22.1.1",
    "helmet": "^8.1.0",
    "mongoose": "^8.18.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "pdfkit": "^0.17.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.3",
    "tsx": "^4.20.5"
  }
}
